# Copy to .env and fill in (never commit .env)
# cp .env.example .env && chmod 600 .env

TELEGRAM_BOT_TOKEN=your_token_from_botfather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Optional — nicer messages (default: html header + hostname + UTC time)
# TELEGRAM_MESSAGE_STYLE=html
# TELEGRAM_SHOW_HEADER=1
# TELEGRAM_HOST=my-server-name
# TELEGRAM_DISABLE_NOTIFICATION=0
#   set to 1 for silent (no sound on phone)
